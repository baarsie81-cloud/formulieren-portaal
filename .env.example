# Copy this file to .env.local and fill in values locally.
# Never commit real secrets or personal data.

# IANA timezone used by the application
TZ=Europe/Amsterdam

# Neon Postgres — pooled URL for the Next.js server runtime
# DATABASE_URL=

# Neon Postgres — direct/unpooled URL for migrations (drizzle-kit migrate)
# DATABASE_URL_UNPOOLED=

# Clerk — server-only secret
# CLERK_SECRET_KEY=

# Clerk — publishable key (browser-safe)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Vercel Blob — private store (token locally; on Vercel OIDC + BLOB_STORE_ID)
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# HMAC secret for hashing client IP addresses on public form sessions.
# Falls back to CLERK_SECRET_KEY when unset.
# HMAC_SECRET=

# Clerk — hosted auth pages in this app
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
